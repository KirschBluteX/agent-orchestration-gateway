{
  "description": "Exact aog.v1 native Agent lifecycle and workspace guardrails.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/aog_hook.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/aog_hook.py\"",
            "timeout": 5,
            "async": false,
            "statusMessage": "Recovering AOG state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|spawn_agent|collaborationspawn_agent|send_message|followup_task|collaborationsend_message|collaborationfollowup_task|interrupt_agent|interruptAgent|collaborationinterrupt_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/aog_hook.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/aog_hook.py\"",
            "timeout": 30,
            "async": false,
            "statusMessage": "Checking AOG dispatch"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|spawn_agent|collaborationspawn_agent|followup_task|collaborationfollowup_task|interrupt_agent|interruptAgent|collaborationinterrupt_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/aog_hook.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/aog_hook.py\"",
            "timeout": 5,
            "async": false,
            "statusMessage": "Recording AOG owner"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/aog_hook.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/aog_hook.py\"",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking active AOG work"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(aog_read_leaf|aog_write_leaf)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/aog_hook.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/aog_hook.py\"",
            "timeout": 120,
            "async": false,
            "statusMessage": "Verifying AOG result"
          }
        ]
      }
    ]
  }
}
