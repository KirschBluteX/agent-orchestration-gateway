{
  "description": "Exact cco.v9 native Agent lifecycle and workspace guardrails.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/cco_hook.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/cco_hook.py\"",
            "timeout": 5,
            "async": false,
            "statusMessage": "Recovering CCO state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|spawn_agent|collaborationspawn_agent|send_message|followup_task|collaborationsend_message|collaborationfollowup_task|interrupt_agent|interruptAgent|collaborationinterrupt_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/cco_hook.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/cco_hook.py\"",
            "timeout": 30,
            "async": false,
            "statusMessage": "Checking CCO dispatch"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|spawn_agent|collaborationspawn_agent|followup_task|collaborationfollowup_task|interrupt_agent|interruptAgent|collaborationinterrupt_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/cco_hook.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/cco_hook.py\"",
            "timeout": 5,
            "async": false,
            "statusMessage": "Recording CCO owner"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/cco_hook.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/cco_hook.py\"",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking active CCO work"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "cost_orchestrator_read_leaf|cost_orchestrator_write_leaf",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/cco_hook.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/cco_hook.py\"",
            "timeout": 120,
            "async": false,
            "statusMessage": "Verifying CCO result"
          }
        ]
      }
    ]
  }
}
