{
  "description": "Global CCO dispatch, task-ledger lifecycle, and bounded result-envelope guardrails.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/ledger_runtime.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/ledger_runtime.py\"",
            "timeout": 5,
            "async": false,
            "statusMessage": "Loading CCO dispatch policy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/agent_preflight.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/agent_preflight.py\"",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking CCO spawn packet"
          }
        ]
      },
      {
        "matcher": "send_message|followup_task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/agent_preflight.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/agent_preflight.py\"",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking CCO continuation packet"
          }
        ]
      },
      {
        "matcher": "interrupt_agent|interruptAgent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/ledger_runtime.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/ledger_runtime.py\"",
            "timeout": 5,
            "async": false,
            "statusMessage": "Retiring CCO owner before interrupt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|spawn_agent|send_message|followup_task)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/ledger_runtime.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/ledger_runtime.py\"",
            "timeout": 5,
            "async": false,
            "statusMessage": "Recording CCO native owner"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "cost_orchestrator_read_leaf|cost_orchestrator_write_leaf",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/hooks/subagent_stop.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/hooks/subagent_stop.py\"",
            "timeout": 120,
            "async": false,
            "statusMessage": "Checking CCO result and workspace"
          }
        ]
      }
    ]
  }
}
